generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 前台会员（注册用户）
model User {
  id              Int        @id @default(autoincrement())
  username        String     @unique
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String?
  nickname        String?
  avatar          String?
  bio             String?
  // 注册邮箱验证码通过后置 true（邮箱注册后锁定不可修改）
  emailVerified   Boolean  @default(false)
  // v0.92 #9 会员资料扩展：联系方式与个人档案（前台会员中心可改）
  wechat          String?
  qq              String?
  telegram        String?
  birthday        DateTime?
  // male | female | other | secret
  gender          String?
  nationality     String?
  // 地区分列存储（前台/后台同源）：countryCode 为 ISO2，province/city/district 为行政区名
  countryCode     String?
  province        String?
  city            String?
  district        String?
  // 详细地址 / 邮编 / 个人网站 / 语言偏好 / 时区（IANA）
  address         String?
  postalCode      String?
  website         String?
  locale          String?
  timezone        String?
  // 会员等级（账号类别统一由等级表表达：普通等级 / 系统等级 importer）
  membershipLevel String          @default("free")
  membershipUntil DateTime?
  // 等级表关联：membershipLevel → MembershipLevel.code（非空外键，指向不存在的等级会被数据库拒绝）
  membership      MembershipLevel @relation("UserMembershipLevel", fields: [membershipLevel], references: [code])
  // active | banned
  status          String     @default("active")
  // 是否允许发布提示词（注册默认允许，后台可单独封禁发布权限）
  allowPublish    Boolean    @default(true)
  // 评论禁言（独立于 status=banned 的登录封禁；true=不能发评论但可正常浏览登录）
  commentBanned   Boolean    @default(false)
  registerIp      String?
  lastLoginAt     DateTime?
  lastLoginIp     String?
  createdAt       DateTime   @default(now())
  prompts         Prompt[]
  likes           Like[]
  favorites       Favorite[]
  userFavorites   UserFavorite[]
  comments        Comment[]
  commentLikes    CommentLike[]
  adminLogs       AdminLog[]
  skills          Skill[]
  usageRecords    UsageRecord[]
  videoTasks      VideoTask[]
  creditGrants    CreditGrant[]
  ledger          CreditLedger[]
  billingReconciles BillingReconcile[]
  payOrders       PayOrder[]
  subscriptions   UserSubscription[]
  messages        UserMessage[]
  generatedAssets GeneratedAsset[]
  apiKeys         UserApiKey[]
}

// 后台管理员（与会员体系完全独立）
model AdminAccount {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  nickname     String?
  // 告警通知邮箱（为空 = 不接收邮件告警）
  email        String?
  // 告警订阅：JSON 数组，如 ["credit_pool","pay_fail"]；NULL / 空数组 = 订阅全部
  alertSubscriptions String? @db.Text
  passwordHash String
  // active | disabled
  status       String     @default("active")
  // true = 超级管理员（全部权限）；false = 按 adminRole 权限表
  isSuper      Boolean    @default(false)
  adminRoleId  Int?
  adminRole    AdminRole? @relation("AdminRoleAdmins", fields: [adminRoleId], references: [id])
  createdIp    String?
  lastLoginAt  DateTime?
  lastLoginIp  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  prompts   Prompt[]
  adminLogs AdminLog[]
}

// 提示词分类
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  nameEn    String
  slug      String   @unique
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  // 自定义栏目 SEO（后台可编辑；空则前台用默认文案）
  metaDescription String? @db.Text
  metaKeywords    String?

  @@index([sort])
}

model Prompt {
  id            Int      @id @default(autoincrement())
  // 作者可空：会员被删除后内容保留，作者置空（前台显示「该会员号已注销」）
  userId        Int?
  title         String
  content       String   @db.Text
  description   String?  @db.Text
  type          String   @default("text")
  category      String   @default("其他")
  language      String   @default("zh")
  promptCode    String?
  model         String?
  tags          String[]
  media         Json     @default("[]")
  coverUrl      String?
  featured      Boolean  @default(false)
  // 热门推荐
  hot           Boolean  @default(false)
  sourceSite    String?
  sourceAuthor  String?
  sourceUrl     String?
  likeCount     Int      @default(0)
  favoriteCount Int      @default(0)
  viewCount     Int      @default(0)
  commentCount  Int      @default(0)
  // 单篇关闭评论：旧评论保留显示，禁止新发
  commentsClosed Boolean @default(false)
  // draft | pending | published | rejected
  status        String   @default("published")
  rejectReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // 发布时间：首次上线时间，与 updatedAt 独立
  publishedAt   DateTime?
  // 后台管理员发布时的作者（前台会员发布走 userId）
  adminAuthorId Int?
  adminAuthor   AdminAccount? @relation(fields: [adminAuthorId], references: [id])

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  likes     Like[]
  favorites Favorite[]
  crawlItem CrawlItem?

  @@index([status, createdAt(sort: Desc)])
  @@index([type])
  @@index([category])
  @@index([language])
  @@index([featured])
  @@index([hot])
  @@index([sourceUrl])
  @@index([adminAuthorId])
}

model Like {
  userId    Int
  promptId   Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  prompt Prompt @relation(fields: [promptId], references: [id])

  @@id([userId, promptId])
}

model Favorite {
  userId    Int
  promptId   Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  prompt Prompt @relation(fields: [promptId], references: [id])

  @@id([userId, promptId])
}

// v0.92 #9 通用收藏（技能/软件；提示词收藏仍走 Favorite 兼容旧数据）
model UserFavorite {
  id         Int      @id @default(autoincrement())
  userId     Int
  // skill | software
  targetType String
  targetId   Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, targetType, targetId])
  @@index([userId, targetType])
}

// 站点配置（键值对，value 为 JSON 字符串）
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// 自动翻译缓存
model TranslationCache {
  hash       String
  sourceLang String
  targetLang String
  translated String @db.Text
  updatedAt  DateTime @updatedAt

  @@id([hash, sourceLang, targetLang])
}

// ─── 后台 RBAC ───

// 管理员角色（多角色多权限）
model AdminRole {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  // 权限列表：["prompt:read",...] 或 ["*"] 表示全部权限
  permissions String[] @default([])
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  admins      AdminAccount[] @relation("AdminRoleAdmins")
}

// 管理员操作日志（只增不删不改）。新日志写 adminId；userId 为历史数据保留
model AdminLog {
  id         Int      @id @default(autoincrement())
  adminId    Int?
  admin      AdminAccount? @relation(fields: [adminId], references: [id])
  // 历史日志挂 User；新日志挂 adminId
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  // 操作类型：create | update | delete | batch_update | login | logout
  action     String
  // 操作对象类型：prompt | user | admin | category | role | setting | comment
  targetType String?
  targetId   Int?
  // 详细变更内容（JSON 字符串）
  detail     String?  @db.Text
  ip         String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([targetType, createdAt(sort: Desc)])
}

// ─── 用户互动 ───

// 通用评论（targetType: prompt | skill | software，未来新栏目直接加值）
model Comment {
  id        Int      @id @default(autoincrement())
  // 作者可空：会员被删除后评论保留，作者置空（前台显示「该会员号已注销」）
  userId    Int?
  // 通用挂载点：目标类型 + 目标 ID（v0.6 起替代原 promptId 硬外键；孤儿评论永不自动清理）
  targetType String  @default("prompt")
  targetId  Int
  content   String   @db.Text
  // 回复目标评论 ID（null=顶级评论）
  parentId  Int?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  // published | hidden | deleted
  status    String   @default("published")
  likeCount Int      @default(0)
  // 审核取证（发布时 IP/UA，仅后台可见）
  ip        String?
  ua        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  likes  CommentLike[]

  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([parentId])
}

// 评论点赞（防重复）
model CommentLike {
  id        Int      @id @default(autoincrement())
  commentId Int
  userId    Int
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([userId])
}

// 外部站点采集：远端作品快照（一键获取更新时 upsert，入库后关联 Prompt）
model CrawlItem {
  id       Int     @id @default(autoincrement())
  source   String  @default("libtv") // 采集源标识，目前仅 libtv
  remoteId String // LIBTV projectUuid
  templateUuid String?
  title    String
  author   String?
  coverUrl String? @db.Text
  tags     String[]
  likeCount Int    @default(0)
  // 作品主类型：首次见到时未知(null)，入库时按节点统计回填 image/video/audio/text
  kind     String?
  remoteCreatedAt DateTime?
  remoteUpdatedAt DateTime?
  // new=待采集 collected=已入库 failed=采集失败（可重试）
  status   String  @default("new")
  error    String? @db.Text
  promptId Int?    @unique
  prompt   Prompt? @relation(fields: [promptId], references: [id])
  skillId  Int?    @unique
  skill    Skill?  @relation(fields: [skillId], references: [id])
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @updatedAt
  collectedAt    DateTime?

  @@unique([source, remoteId])
  @@index([source, status, remoteUpdatedAt(sort: Desc)])
  @@index([source, remoteUpdatedAt(sort: Desc)])
}

// 采集入库后台任务（异步执行，前端轮询进度）
model CrawlJob {
  id        Int      @id @default(autoincrement())
  source    String   @default("libtv")
  kind      String   @default("import")
  // running=进行中 done=已结束（失败数见 failed，整任务异常写 message）
  status    String   @default("running")
  total     Int      @default(0)
  done      Int      @default(0)
  succeeded Int      @default(0)
  failed    Int      @default(0)
  // 只保留最后一条失败原因（进度区展示用）
  lastError String?  @db.Text
  message   String?  @db.Text
  itemIds   Int[]
  adminId   Int
  createdAt DateTime @default(now())
  finishedAt DateTime?

  @@index([status, createdAt(sort: Desc)])
}

// ─── v0.6 AI技能 ───

// 技能分类（slug 为 2 字母短码，与提示词分类风格一致）
model SkillCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  nameEn    String
  slug      String   @unique
  icon      String   @default("")
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  // 自定义栏目 SEO（后台可编辑；空则前台用默认文案）
  metaDescription String? @db.Text
  metaKeywords    String?

  skills Skill[]

  @@index([sort])
}

// AI 技能（SKILL.md 完整内容 + 附加文件清单）
model Skill {
  id            Int      @id @default(autoincrement())
  // slug 允许重复（URL 形式为 slug-id，按 id 精确定位）
  slug          String
  name          String
  // "Use when..." 触发语（列表卡片展示）
  summary       String   @db.Text
  // SKILL.md 完整内容
  skillMd       String   @db.Text
  // 附加文件 [{path, content, size}]
  files         Json     @default("[]")
  categoryId    Int
  category      SkillCategory @relation(fields: [categoryId], references: [id])
  tags          String[]
  author        String?
  sourceUrl     String?
  sourceSite    String?
  version       String?
  license       String?
  language      String   @default("zh")
  // published | pending | rejected
  status        String   @default("published")
  // 精选（后台开关，首页「精选技能展示」只取 featured=true）
  featured      Boolean  @default(false)
  viewCount     Int      @default(0)
  commentCount  Int      @default(0)
  copyCount     Int      @default(0)
  downloadCount Int      @default(0)
  // 发布者（系统账号 system）；会员被删除后置空，技能保留
  userId        Int?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId])
  @@index([viewCount])
  @@index([slug])

  // 采集入口：CrawlItem 可关联 Skill（prompthub-skills 入库）
  crawlItems CrawlItem[]
}

// ─── v0.6 AI软件 ───

// 软件分类
model SoftwareCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  nameEn    String
  slug      String   @unique
  icon      String   @default("")
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  // 自定义栏目 SEO（后台可编辑；空则前台用默认文案）
  metaDescription String? @db.Text
  metaKeywords    String?

  software Software[]

  @@index([sort])
}

// AI 软件
model Software {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  name          String
  version       String?
  // 一句话简介（列表卡片用）
  tagline       String?
  // 详细介绍（富文本，sanitize-html 净化）
  description   String   @db.Text
  // 图标（自动本地化后的 /uploads 路径）
  icon          String?
  categoryId    Int
  category      SoftwareCategory @relation(fields: [categoryId], references: [id])
  tags          String[]
  sizeText      String?
  platform      String?
  language      String?
  officialUrl   String?
  // published | pending | rejected
  status        String   @default("published")
  viewCount     Int      @default(0)
  downloadCount Int      @default(0)
  commentCount  Int      @default(0)
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  downloads SoftwareDownload[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId])
  @@index([downloadCount])
}

// 软件下载地址（一个软件多条；local=本站 /uploads，bucket=对象存储）
model SoftwareDownload {
  id          Int      @id @default(autoincrement())
  softwareId  Int
  software    Software @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  // "官方原版 dmg" / "免安装绿色版"
  label       String
  // local | bucket
  storageType String   @default("local")
  bucketId    Int?
  bucket      StorageBucket? @relation(fields: [bucketId], references: [id])
  // 桶内对象 key（storageType=bucket 时使用）
  objectKey   String?
  // local 模式：/uploads/soft/xxx.zip
  fileUrl     String?
  sizeBytes   BigInt?
  // 是否会员登录后可见/可下载（下载 API 层强制校验）
  memberOnly  Boolean  @default(false)
  sort        Int      @default(0)
  downloadCount Int    @default(0)

  @@index([softwareId, sort])
}

// ─── v0.6 对象存储 ───

// 存储桶配置（MinIO/S3 兼容；SecretKey AES-256-GCM 加密存储不回显）
model StorageBucket {
  id           Int      @id @default(autoincrement())
  // 管理备注名，如 "MinIO主桶"
  name         String
  // minio | s3（API 均为 S3 兼容）
  type         String   @default("minio")
  endpoint     String
  // S3 需要，MinIO 可空
  region       String?
  bucket       String
  accessKey    String
  // 加密存储（enc:v1:iv:tag:cipher）
  secretKey    String
  // 公开读 CDN 域名（公开下载直链用）
  publicBaseUrl String?
  // 发布软件时的默认选中桶
  isDefault    Boolean  @default(false)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  downloads SoftwareDownload[]
  generatedAssets GeneratedAsset[]
}

// ─── v0.85 神器·全能提示词优化器使用记录 ───
// 每次前台调用 /api/optimize 记录一条（成功写 output，失败写 error）
// 仅供后台查看，不关联用户账号（即使已登录会员也不记录账号）
model OptimizerLog {
  id        Int      @id @default(autoincrement())
  ip        String   @default("")
  source    String   @default("home") // home=首页神器区 / shenqi=单页工具页
  input     String   @db.Text
  output    String   @default("") @db.Text
  error     String   @default("") @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── P0 站务改版：固定单页 ───
// 固定单页（帮助/关于/联系/条款/隐私，后台可编辑富文本）
model SitePage {
  slug      String   @id                  // help | about | contact | terms | privacy（固定白名单）
  title     String                       // 中文标题（后台可改）
  content   String   @default("") @db.Text // 富文本 HTML（sanitize 净化）
  updatedAt DateTime @updatedAt

  @@map("site_page")
}

// ─── P1 聚合网关：模型库管理（计费真源） ───

// AI 厂商（上游渠道）
model AiVendor {
  id        Int      @id @default(autoincrement())
  name      String   @unique          // 厂商显示名：DeepSeek / 多模型平台
  slug      String   @unique          // deepseek | siliconflow 等
  apiBase   String                    // 上游 API Base URL
  protocol  String   @default("openai") // openai=OpenAI 兼容
  status    String   @default("online") // online | deprecated | offline
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  keys      VendorApiKey[]
  models    AiModel[]
  @@map("ai_vendor")
}

// 上游 API Key（密文存储，不回显）
model VendorApiKey {
  id         Int      @id @default(autoincrement())
  vendorId   Int
  vendor     AiVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name       String                    // 管理备注名
  keyPrefix  String                    // 明文前缀（识别用，如 sk-abc***）
  keyCipher  String                    // 密文 enc:v1:iv:tag:cipher
  // active | disabled
  status     String   @default("active")
  // P2 路由权重（≥1；加权随机选路，越大流量越多）
  weight     Int      @default(1)
  // P5 维护窗口：到该时间点前不参与选路（null=不在维护中）
  maintainUntil DateTime?
  remark     String?
  // 运营标签（批量打标：如 生产 / 测试 / 高并发）
  tags       String[] @default([])
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([vendorId])
  @@map("vendor_api_key")
}

// AI 模型
model AiModel {
  id           Int      @id @default(autoincrement())
  vendorId     Int
  vendor       AiVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name         String                    // 上游模型名（调用透传）
  displayName  String                    // 展示名
  // chat | embedding | image | video | audio
  endpointType String   @default("chat")
  // online | deprecated | offline
  status       String   @default("online")
  remark       String?
  // 高级配置（JSON 文本）：该模型的高级参数与细节调整
  advancedConfig String? @db.Text
  // P4 能力矩阵（JSON 文本）：{"params":["temperature","max_tokens",...],"modalities":["text","image"]}
  // null = 全透传（向后兼容）；配置后 chat 请求参数超出白名单 → 400 指名不支持
  capabilities Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  endpoints    ModelEndpoint[]
  pricings     ModelPricing[]
  @@unique([vendorId, name])
  @@map("ai_model")
}

// 汇率表（基本常量）：币种 → RMB 汇率（×1e8），模型管理里所有汇率统一引用此处
model FxRate {
  id        Int      @id @default(autoincrement())
  currency  String   @unique // 如 USD
  rateE8    BigInt // 1 单位外币 = rateE8/1e8 元人民币
  updatedAt DateTime @updatedAt
  @@map("fx_rate")
}

// 模型端点
model ModelEndpoint {
  id        Int      @id @default(autoincrement())
  modelId   Int
  model     AiModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  // chat_completions | image_generations | video_generations
  path      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  @@unique([modelId, path])
  @@map("model_endpoint")
}

// 模型定价（调价历史：多行按 effectiveAt 取最新生效）
model ModelPricing {
  id            Int      @id @default(autoincrement())
  modelId       Int
  model         AiModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  // 计量基数：per_1m_token=1000000、per_image/per_video_second/per_request=1
  meterBase     Int      @default(1000000)
  // token | image | video_second | request
  unit          String   @default("token")
  inputPrice    Decimal  @default(0) @db.Decimal(18, 8)  // 输入单价（供应商币种/计量基数）
  outputPrice   Decimal  @default(0) @db.Decimal(18, 8)  // 输出单价
  currency      String   @default("CNY")
  fxRateE8      BigInt   @default(100000000)             // 汇率放大 1e8（兑人民币）
  multiplierBps Int      @default(150)                   // 加价系数基点（150=1.5x）— 会员价未填时兜底
  // v0.96 直观定价：会员价按输入/输出直接填（积分/计量基数；token 模型即积分/1M tokens）
  memberInputPrice  Decimal? @db.Decimal(18, 8)
  memberOutputPrice Decimal? @db.Decimal(18, 8)
  // 计费档位键（空字符串 = 通用/兜底）。视频按分辨率×是否含视频输入分档：
  //   480p:n / 720p:n / 1080p:n / 4K:n / 720p:v（n=输入不含视频，v=输入含视频）
  variant       String   @default("")
  effectiveAt   DateTime @default(now())                 // 调价生效时间
  createdAt     DateTime @default(now())
  @@unique([modelId, variant, effectiveAt])
  @@index([modelId, effectiveAt(sort: Desc)])
  @@map("model_pricing")
}

// ─── P1 聚合网关：调用日志（方案第 4 章 usage_record） ───
// 每次网关调用一条；cost_milli 为内部成本（毛利报表用），paid_credits 为用户实扣整数积分（ceil）
// api_key_id/model_id 按方案为 bigint 无外键（站外 Key 表 user_api_key 随 P5 落库）
model UsageRecord {
  id            Int      @id @default(autoincrement())
  // 会员被删除后流水保留，作者置空
  userId        Int?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiKeyId      BigInt?
  // onsite | apikey
  channel       String
  modelId       BigInt?
  // chat | image | video | audio
  endpointType  String
  vendorKeyId   BigInt?
  // 模型名快照（调用时点）
  modelSnapshot String
  promptTokens  Int      @default(0)
  outputTokens  Int      @default(0)
  unitCount     Int      @default(1)
  // 内部成本，毫积分（1 积分 = 1000 毫）
  costMilli     BigInt   @default(0)
  // 用户实扣整数积分（ceil，最低 1 分）
  paidCredits   BigInt   @default(0)
  latencyMs     Int?
  // success | failed | blocked | cancelled（P2：客户端断连按已发生用量结算）
  status        String
  // P3 价格版本：结算时点的定价行 ID + 单价快照 JSON（调价不回写历史账单，可按快照重算）
  priceVersionId BigInt?
  priceSnapshot  String? @db.Text
  requestId     String
  createdAt     DateTime @default(now())

  @@unique([requestId], map: "uk_usage_request")
  @@index([userId, createdAt(sort: Desc)], map: "idx_usage_user_daily")
  @@index([modelId, createdAt(sort: Desc)], map: "idx_usage_model_daily")
  @@map("usage_record")
}

// ─── P6 #19 异步视频生成任务（/v1/videos task_id 状态机） ───
// 创建即返 task_id，进程内后台执行（P6 #20 迁 BullMQ 多实例）；
// requestId 幂等：客户端 Idempotency-Key 重试返回同一任务，不重复扣费。
// 卡死兜底：进程重启卡 processing 的任务由 GET 惰性超时标 failed，退款走 P3 对账扫描。
model VideoTask {
  id            Int      @id @default(autoincrement())
  // 对外任务 ID（vt- 前缀随机串，不暴露自增主键）
  taskId        String   @unique
  // 计费幂等键（= usage_record.requestId，Idempotency-Key 派生）
  requestId     String   @unique
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  apiKeyId      BigInt?
  channel       String   // onsite | apikey
  modelId       Int
  modelSnapshot String
  vendorKeyId   Int?
  // queued | processing | succeeded | failed
  status        String   @default("queued")
  progress      Int      @default(0) // 0-100（上游无进度按阶段估）
  // ── 队列租约（P6 #21 常驻 Worker）──
  // 已执行次数（含重启接管）；达到上限仍未完成则由 reconciler 失败退款
  attempts      Int      @default(0)
  // 租约到期时间：执行中每 60s 续租；过期后允许其它 Worker 接管
  lockedUntil   DateTime?
  // 当前持有租约的 Worker 标识（host:pid:rand），用于条件更新防交叉写
  workerId      String?
  // 生成参数 JSON（审计/重试）
  payload       String   @db.Text
  // 成功产物：转存资产 ID（下载走签名 URL）；转存失败兜底存原始 URL JSON
  assetId       Int?
  resultUrls    String?  @db.Text
  errorMessage  String?  @db.Text
  costMilli     BigInt   @default(0)
  paidCredits   BigInt   @default(0)
  latencyMs     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  finishedAt    DateTime?
  @@index([userId, createdAt(sort: Desc)])
  @@map("video_task")
}

// ─── P2 会员积分闭环（方案第 4 章） ───

// 积分包（充值商品，价格单位：分）
model CreditPack {
  id         Int      @id @default(autoincrement())
  // 商品码：p30 / p50 / p200
  packCode   String   @unique
  // 价格（人民币分）
  priceCents BigInt
  // 购买积分（整数积分，不含赠送）
  credits    BigInt
  // 赠送积分（v0.92 #2：与购买积分分开填写，前台「5000积分 + 赠100积分」）
  bonusCredits BigInt @default(0)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  payOrders PayOrder[]

  @@map("credit_pack")
}

// 积分授予（余额真源：有效 grant 的 remainingCredits 求和）
model CreditGrant {
  id               Int       @id @default(autoincrement())
  userId           Int?
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  // subscription | topup | gift | trial
  grantType        String
  totalCredits     BigInt
  remainingCredits BigInt
  // 有效期（null = 永不过期）
  expiresAt        DateTime?
  // 来源幂等键（订单号 / 活动标识等，与 userId+grantType 联合唯一）
  sourceRef        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, grantType, sourceRef])
  // 消费扫描：idx_credit_grant_consume（按先过期先扣，NULLS LAST）
  @@index([userId, expiresAt], map: "idx_credit_grant_consume")
  @@map("credit_grant")
}

// 积分流水（只增不改；requestId 幂等）
model CreditLedger {
  id           Int      @id @default(autoincrement())
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // 变动量（正=入账，负=扣减）
  changeAmount BigInt
  balanceAfter BigInt
  // grant | consume | refund | admin_adjust
  reason       String
  refType      String?
  refId        String?
  // 幂等键（唯一索引冲突则跳过写入）
  requestId    String?  @unique(map: "uk_credit_ledger_req")
  createdAt    DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("credit_ledger")
}

// ─── S0-3 计费对账：结算/退款失败落库，由幂等重试任务兜底 ───
// settle/refund 抛异常时写入（requestId+kind 幂等），后台重试成功后标记 done。
// 重试安全依据：CreditLedger.requestId 唯一约束保证同键不重复入账/扣款。
model BillingReconcile {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // 关联网关请求（与 CreditLedger.requestId 同源）
  requestId String
  // settle | refund
  kind      String
  // 应结算/应退积分（重试时重新计算，此值仅作审计参考）
  amount    BigInt
  // pending | done | failed
  status    String   @default("pending")
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, kind], map: "uk_billing_reconcile_req")
  @@index([status, createdAt])
  @@map("billing_reconcile")
}

// ─── 响应级幂等：同一 Idempotency-Key 的成功响应回放（v0.94） ───
// requestId 与计费幂等键同源（user + Key + 端点 + 模型 + body 指纹）。
// 只缓存成功响应：失败不写，否则一次失败会把后续重试全部堵死。
// 不存二进制：媒体产物在响应体里是我们自己的资产 URL，二进制在对象存储。
// pending = 首个请求执行中（并发重复请求据此返回 409，避免重复调用上游）。
model IdempotencyRecord {
  id             Int      @id @default(autoincrement())
  requestId      String   @unique
  userId         Int
  endpoint       String
  // pending | completed
  status         String   @default("pending")
  responseStatus Int?
  responseBody   Json?
  // pending 期：接管阈值（进程崩溃后可被新请求接管）；completed 后：回放有效期
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
  @@map("idempotency_record")
}

// ─── P7 邮件体系：验证码（注册/找回密码） ───
// 只存 sha256(code) 哈希，不存明文；验证失败计 attempts，≥5 次作废
model EmailCode {
  id         Int       @id @default(autoincrement())
  email      String
  // register | reset
  purpose    String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose, createdAt(sort: Desc)])
  @@map("email_code")
}

// ─── P7 邮件体系：可编辑邮件模板（后台维护，{{var}} 插值） ───
model EmailTemplate {
  id        Int      @id @default(autoincrement())
  // register_code | reset_code | test_mail
  key       String   @unique
  subject   String
  bodyHtml  String   @db.Text
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("email_template")
}

// 充值订单（充值记录订单号语义必需）
model PayOrder {
  id              Int        @id @default(autoincrement())
  // 订单号（对外幂等键）
  orderNo         String     @unique
  userId          Int?
  user            User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  packId          Int
  pack            CreditPack @relation(fields: [packId], references: [id])
  // 应付金额（人民币分）
  amountCents     BigInt
  // wechat | alipay | custom | stripe | crypto
  channel         String
  // pending | paid | failed | closed
  status          String     @default("pending")
  // 支付回调事件号（回调幂等）
  providerEventId String?    @unique(map: "uk_pay_order_event")
  paidAt          DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("pay_order")
}

// 会员订阅计划（表结构就绪，暂不启用售卖）
model MemberPlan {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  // 价格（人民币分）
  priceCents  BigInt
  // month | year
  period      String   @default("month")
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions UserSubscription[]

  @@map("member_plan")
}

// 用户订阅（表结构就绪，暂不启用）
model UserSubscription {
  id        Int        @id @default(autoincrement())
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  planId    Int
  plan      MemberPlan @relation(fields: [planId], references: [id])
  // active | expired | canceled
  status    String     @default("active")
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, status])
  @@map("user_subscription")
}

// 账号等级（替代 User.role 区分账号类别）：
//   regular 普通等级（会员可登录、可后台授予）
//   system  系统等级（采集号/历史管理员，不可前台登录、不给调网关 API Key）
// 物理列 User.membershipLevel 直接作为外键指向本表 code。
model MembershipLevel {
  code           String   @id
  // 显示名（后台可改）
  name           String
  // true = 系统等级（不可前台登录）
  isSystem       Boolean  @default(false)
  // 是否允许前台登录（登录闸门只看这个字段）
  canLogin       Boolean  @default(true)
  // 默认等级：禁止删除、可改名；全表唯一（数据库层部分唯一索引兜底）
  isDefault      Boolean  @default(false)
  // 获得条件文案，例如「注册自动获得」「后台授予」「系统创建」
  grantCondition String   @default("")
  sortOrder      Int      @default(0)
  // 仅控制后台可选性，不影响登录
  isActive       Boolean  @default(true)
  remark         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  users          User[]   @relation("UserMembershipLevel")

  @@map("membership_level")
}

// ─── P4 用户中心：消息·工单（双向合一） ───
// 会话 = 根消息（replyToId NULL）+ 回复（replyToId 指向会话根消息，串成对话）
// 工单状态 ticketStatus 维护在会话根消息上：open=待管理员处理 / replied=管理员已回 / closed=已关闭
model UserMessage {
  id           BigInt       @id @default(autoincrement())
  userId       Int?
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  // user_to_admin | admin_to_user
  direction    String
  // ticket | notice
  msgType      String
  subject      String?
  body         String       @db.Text
  // open | pending | replied | closed（仅工单会话根消息维护）
  ticketStatus String?
  // 自关联：回复指向会话根消息（NULL = 根消息）
  replyToId    BigInt?
  replyTo      UserMessage? @relation("MessageThread", fields: [replyToId], references: [id])
  replies      UserMessage[] @relation("MessageThread")
  // 群发批次号（uuid，单发为 NULL）
  batchId      String?
  // 已读时间（NULL = 未读；只对 admin_to_user 方向有意义）
  readAt       DateTime?
  // v0.92 #4：管理员回复人（管理账号 / 昵称快照；前台只显昵称）
  replyBy      String?
  replyByNick  String?
  // v0.92 #4：管理员已读时间（只对 user_to_admin 消息有意义；NULL = 新会员消息）
  adminReadAt  DateTime?
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([direction, ticketStatus, createdAt])
  @@map("user_message")
}

// ─── P4 用户中心：生成资产（P5 生成链路写入，本期建表 + 我的资产列表页） ───
// 生成物默认 30 天过期（expireAt），软删（status=deleted）不物理删除
model GeneratedAsset {
  id            BigInt         @id @default(autoincrement())
  // 会员被删除后产物保留，作者置空
  userId        Int?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  // 关联调用日志（P5 写入，无外键对齐 usage_record.id 语义）
  usageRecordId BigInt?
  // image | video | audio | speech | music | sfx | model3d | text | document | archive | other | file（历史值）
  assetType     String
  // 产物真实 MIME（落桶时按文件头嗅探写入；嗅探不出保持 NULL，不用上游 octet-stream 乱填）
  mimeType      String?
  bucketId      Int?
  bucket        StorageBucket? @relation(fields: [bucketId], references: [id])
  storageKey    String
  sizeBytes     BigInt         @default(0)
  sha256Hex     String?
  // temp | deleted
  status        String         @default("temp")
  // 过期时间（默认创建后 30 天，NULL = 不过期）
  expireAt      DateTime?
  // 上游产物 URL（仅转存失败 status=deleted 时留存，供用户重试拉取一次）
  sourceUrl     String?        @db.Text
  createdAt     DateTime       @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("generated_asset")
}

// ─── P5 站外双通道：站外会员 Key ───
// 明文 sk-xxx 只在创建时返回一次，库内只存 sha256（keyHash）
model UserApiKey {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  // 自定义名称（会员创建时可命名，便于区分多把 Key）
  name       String?
  // 明文前缀（识别展示用，如 sk-ab12cd34）
  keyPrefix  String
  // sha256(明文)，hex 64 位
  keyHash    String    @unique
  // active | revoked
  status     String    @default("active")
  // 过期时间（NULL = 永不过期）
  expiresAt  DateTime?
  // 额度上限（积分；NULL = 不限额）
  quotaCredits Int?
  // 额度已用（原子消耗计数：预占 + 结算口径，防并发超卖）
  usedCredits  BigInt   @default(0)
  // b1 模型白名单（空数组 = 不限制；元素为调用时 model 参数值）
  allowedModels String[] @default([])
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("user_api_key")
}

// ─── API Key 额度预占（b2 硬额度） ───
// preDeduct 时按预估积分预占 Key 额度；settle / refund 按 requestId 收口，防并发超卖。
model ApiKeyQuotaHold {
  id        Int      @id @default(autoincrement())
  requestId String   @unique
  apiKeyId  Int
  // 预占积分
  amount    Int
  createdAt DateTime @default(now())

  @@index([apiKeyId])
  @@map("api_key_quota_hold")
}

// ─── P6 运营告警（积分池/毛利/支付异常/注册异常巡检记录） ───
// checkOperationalAlerts（src/lib/alerts.ts）巡检命中后写入；ackAt 非空 = 已确认
model OperationalAlert {
  id        Int       @id @default(autoincrement())
  // credit_pool=积分池 | gross_margin=毛利 | pay_fail=支付异常 | register_burst=注册异常
  // usage_invalid=用量记录异常 | reconcile_failed=对账重试耗尽（scanReconcile 写入）
  alertType String
  // warn | critical
  level     String
  message   String
  // 巡检快照 JSON（阈值/实测值/会员与请求信息）
  payload   String    @default("{}")
  // 确认时间（NULL = 未确认）
  ackAt     DateTime?
  createdAt DateTime @default(now())

  @@index([alertType, createdAt(sort: Desc)])
  @@index([ackAt, createdAt(sort: Desc)])
  @@map("operational_alert")
}

// ─── 冰山实验场 M2：会话与消息（仅新增，不改动既有 model） ───
// userId 不建外键关系，避免改动 User model；按用户查询走 [userId, updatedAt] 索引。
model PlaygroundSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String   @default("新对话")
  modelName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages PlaygroundMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("playground_session")
}

model PlaygroundMessage {
  id           Int      @id @default(autoincrement())
  sessionId    Int
  // user | assistant
  role         String
  content      String   @db.Text
  promptTokens Int      @default(0)
  outputTokens Int      @default(0)
  // 媒体任务关联（图片 / 视频）：刷新或重新登录后据此恢复产物与任务状态
  taskId       String?
  createdAt    DateTime @default(now())

  session PlaygroundSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("playground_message")
}

// ─── 冰山实验场 M4：统一媒体任务（图片 / 视频共用一套状态机） ───
// 提交即返回 taskId，后台 worker 执行：图片=同步上游放后台跑，视频=上游三段式任务轮询。
// 前端轮询任务状态；状态在库，用户关页面/刷新不丢任务。
// userId 不建外键关系（同 PlaygroundSession，避免改动既有 User model）。
model PlaygroundMediaTask {
  id            Int      @id @default(autoincrement())
  // 对外任务 ID（mt- 前缀随机串，不暴露自增主键）
  taskId        String   @unique
  // 计费幂等键（= usage_record.requestId）
  requestId     String   @unique
  userId        Int
  // image | video
  kind          String
  modelId       Int
  modelSnapshot String
  // 实际命中的上游 Key（重试换 Key 后记录成功的那个）
  vendorKeyId   Int?
  // queued | running | succeeded | failed
  status        String   @default("queued")
  progress      Int      @default(0)
  // ── 队列租约（P6 #21 常驻 Worker）──
  attempts      Int      @default(0)
  lockedUntil   DateTime?
  workerId      String?
  // 阶段文案：排队中 / 提交上游 / 生成中 / 下载产物 / 结算中
  stage         String?
  // 生成参数与上游请求快照 JSON
  params        String   @db.Text
  requestSize   String?
  // 视频结算依据：上游报价（USD）+ 报价单号（10 分钟有效），图片为空走 model_pricing
  quoteUsd      Decimal? @db.Decimal(18, 8)
  quoteId       String?
  // 预估预扣积分 / 实扣积分 / 内部成本（毫积分）
  estCredits    Int      @default(0)
  paidCredits   BigInt   @default(0)
  costMilli     BigInt   @default(0)
  // 产物 URL JSON（本地落盘地址或上游兜底临时地址）
  resultUrls    String?  @db.Text
  errorMessage  String?  @db.Text
  latencyMs     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  startedAt     DateTime?
  finishedAt    DateTime?
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("playground_media_task")
}
