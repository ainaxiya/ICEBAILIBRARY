# ============================================================
# CompletePrompt 环境变量模板
# 用法：cp .env.example .env 后按注释逐项填写；真实密钥严禁入库
# ============================================================

# ============ 数据库 ============
# 本地开发（Windows PostgreSQL 服务，端口 5433，库 icebaidata；连服务即可，不自建实例）
DATABASE_URL="postgresql://postgres:123123aa@localhost:5433/icebaidata?schema=public"
# 服务器（Docker 版 PG，见 docker-compose.yml；生产建议追加连接池参数）
# DATABASE_URL="postgresql://用户名:你的密码@127.0.0.1:35432/prompthub?schema=public&connection_limit=20&pool_timeout=10"

# ============ 认证 ============
# 会员令牌签名密钥，必须更换：openssl rand -hex 32（生产缺失会 fail-fast 拒绝启动）
JWT_SECRET="change-me-to-a-random-32-byte-hex"
# 管理员令牌独立密钥（缺省回退 JWT_SECRET 并告警；建议生产单独配置）
JWT_ADMIN_SECRET=""
# 令牌有效期（天），留空/非法值回退 30 与 7
JWT_USER_TTL_DAYS="30"
JWT_ADMIN_TTL_DAYS="7"

# ============ Meilisearch ============
# 服务器：https://meili.你的域名.com；本地：http://127.0.0.1:7700
MEILI_HOST="http://127.0.0.1:7700"
MEILI_MASTER_KEY="change-me-meili-master-key"

# ============ 站点域名（代码不写死域名，全部从这里读，改域名只改本段）============
# 主站对外主域名（宣传/canonical/sitemap/水印统一用它；构建时打包进前端）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# API 网关域名（/v1 接口 + API 文档 Base URL 默认值），生产如 https://api.icebai.com
API_GATEWAY_BASE_URL="http://localhost:3000"
# /v1 网关白名单域名（逗号分隔，多 API 域名=多线路；默认取 API_GATEWAY_BASE_URL 的域名）
# 生产示例：API_GATEWAY_HOSTS="api.icebai.com,api.wango8.com"
API_GATEWAY_HOSTS=""

# ============ 存储与第三方密钥 ============
# 存储桶 SecretKey 字段级加密密钥（AES-256-GCM）：生成 openssl rand -hex 32
# 更换后已存 SecretKey 将无法解密，需在后台重新填写
STORAGE_KEY_SECRET="change-me-32-byte-hex-for-aes-gcm"
# 神器·全能提示词优化器兜底密钥（后台「网站设置」配置优先）
DEEPSEEK_API_KEY=""

# ============ 运行时 ============
# 应用监听端口（PM2 与中间件内部回环请求共用；默认 3000）
PORT="3000"
# PM2 内存上限，超限自动重启（默认 1G）
PM2_MAX_MEMORY="1G"
# ffmpeg 可执行文件路径（默认走 PATH 中的 ffmpeg；Windows 可填绝对路径）
FFMPEG_PATH=""
# ffprobe 可执行文件路径（默认走 PATH；缺失时视频采集跳过时长校验，仅做体积限制）
FFPROBE_PATH=""

# ============ 采集视频本地化（可选，留空走代码默认值）============
# 单条视频体积上限（MB），超限降级为仅保留截帧并在前台标注原因
CRAWL_VIDEO_MAX_MB="60"
# 单条视频时长上限（秒），超限同样降级为截帧
CRAWL_VIDEO_MAX_SECONDS="60"
# 单次视频下载超时（毫秒），大文件下载失败会重试 3 次
CRAWL_VIDEO_TIMEOUT_MS="120000"
# Redis 连接串（配置后启用 BullMQ 视频队列与多实例 worker；留空则走进程内队列）
# o13：同一 REDIS_URL 也用于多实例共享「限流 / 配额 / 并发槽 / Key 熔断」状态，未配置时全部回退进程内
REDIS_URL=""
# 共享状态客户端的连接超时（毫秒，默认 1000）与命令超时（毫秒，默认 800）
# 两者只作用于请求热路径的短连接；视频入队短连接与 worker 长连接的超时不受影响
SHARED_REDIS_CONNECT_TIMEOUT_MS="1000"
SHARED_REDIS_TIMEOUT_MS="800"
# /api/cron/* 定时任务鉴权密钥（crontab 调用时通过请求头携带）
CRON_SECRET=""

# ============ 实验场 / 网关任务（可选，留空走代码默认值）============
# 媒体存储模式：local（默认，落 public/uploads）| s3（落默认存储桶）
PLAYGROUND_MEDIA_STORAGE="local"
# 会话留存天数（0/留空=不自动清理）
PLAYGROUND_SESSION_RETENTION_DAYS="0"
# 技能白名单（逗号分隔 slug；留空=不限制）
PLAYGROUND_SKILL_WHITELIST=""
# 视频任务轮询间隔毫秒（默认 3000，最小 1000）
VIDEO_TASK_POLL_MS="3000"
# 视频 worker 并发（默认 1：状态轮询轻量，单线串行足够；图片生成走独立通道，不与此共用）
VIDEO_WORKER_CONCURRENCY="1"

# ============ 字节跳动语音 bytedance（可选，留空走代码默认值）============
# 历史变量名 OPENSPEECH_* 仍兼容，优先级低于 BYTEDANCE_TTS_*
# 同步音频生成（/api/v3/tts/create）上游超时毫秒（默认 330000，官方示例 max-time 300s）
BYTEDANCE_TTS_CREATE_TIMEOUT_MS="330000"
# 异步长文本（submit/query）最长等待毫秒（默认 900000 = 15 分钟；超时按失败全额退款）
BYTEDANCE_TTS_ASYNC_WAIT_MS="900000"
# 异步轮询起始/最大间隔毫秒（默认 1000 / 3000，指数退避）
BYTEDANCE_TTS_POLL_MIN_MS="1000"
BYTEDANCE_TTS_POLL_MAX_MS="3000"

# ============ 本地压测（可选，仅 scripts/k6 使用）============
# 压测应用地址与 mock 上游端口
K6_BASE_URL="http://127.0.0.1:3101"
MOCK_PORT="19810"
# 压测夹具使用的测试库（与应用库隔离）
K6_TEST_DB_URL="postgresql://postgres@127.0.0.1:5432/prompthub_test?schema=public"
K6_ADMIN_DB_URL="postgresql://postgres@127.0.0.1:5432/postgres"
